# Tip Autopsy — Root Environment Example
# Copy frontend/.env.example -> frontend/.env and backend/.env.example -> backend/.env
# Never commit real secrets or service-role keys.

# Frontend (public client variables only — NEVER put secrets here)
VITE_API_BASE_URL=http://localhost:8000

# Backend (server-side only)
APP_ENV=development
NODE_ENV=development
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
DATABASE_URL=postgresql://postgres:replace-with-password@db.your-project-ref.supabase.co:5432/postgres

# Optional bounded multimodal/LLM parser (server-side only; leave unset to use structured fallback)
LLM_PROVIDER=disabled
LLM_API_KEY=

# Optional Sarvam voice readout (server-side only; deferred to Phase 3)
SARVAM_API_KEY=
